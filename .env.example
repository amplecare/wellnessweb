# Copy to .env.local and fill in. .env.local is git-ignored — never commit real values.
#
# Generate ADMIN_PASSWORD_HASH and AUTH_SECRET together with:
#
#   node scripts/set-admin-password.mjs
#   (type the password, press Enter)
#
# The plaintext password is never stored anywhere. To rotate it, run the script
# again and replace both lines below.

# The single address permitted to sign in to /admin.
ADMIN_EMAIL=you@example.com

# scrypt hash of the admin password. Format: scrypt$N$r$p$salt$hash
ADMIN_PASSWORD_HASH=

# Signs the admin session cookie. 32+ characters, random.
# Changing this immediately invalidates every existing session.
AUTH_SECRET=

# --- Supabase -----------------------------------------------------------------
# Project Settings → API in the Supabase dashboard.

# Safe in the browser ONLY when Row Level Security is on for every table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses Row Level Security entirely. Server-side only — never NEXT_PUBLIC_,
# never imported into a client component. Treat it like a root password.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for migrations. URL-encode special characters in
# the password (@ becomes %40) or the connection string will not parse.
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres
